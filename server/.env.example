# OperIQ API
PORT=4000

# Database
# Leave empty to store sandbox data in server/.local/state.json.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/operiq

# AI model (GroqCloud uses an OpenAI-compatible API)
# Paste your Groq API key into OPENAI_API_KEY.
OPENAI_API_KEY=gsk_your_groq_api_key
OPENAI_MODEL=openai/gpt-oss-120b
# GROQ_MODEL is also supported for compatibility with older local .env files.
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Execution mode: use sandbox while developing; live requires all ArmorIQ values below.
EXECUTION_MODE=sandbox

# Authentication. Generate a long random value and keep it private.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Optional separate AES key for encrypted durable ArmorIQ Hold jobs.
# When omitted, JWT_SECRET is used.
GOVERNANCE_JOB_SECRET=replace_with_another_long_random_secret
# How often a restarted server checks pending ArmorIQ delegations.
HOLD_RECOVERY_INTERVAL_MS=15000

# Repeated ArmorIQ-blocked customer actions trigger a temporary customer rate
# limit and a human-approved Business AI pause request.
SECURITY_BLOCK_THRESHOLD=3
SECURITY_BLOCK_WINDOW_MS=600000
SECURITY_RATE_LIMIT_MS=1800000
SECURITY_BUSINESS_CUSTOMER_THRESHOLD=3
# Use an email that belongs to the ArmorIQ organization administering OperIQ.
SECURITY_AUTOMATION_USER_EMAIL=security-admin@example.com

# Firebase Admin service account (Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Keep the escaped newlines when this is stored on one line in .env.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ArmorIQ
ARMORIQ_API_KEY=your_armoriq_api_key
ARMORIQ_AGENT_ID=operiq-coordinator
ARMORIQ_ADMIN_AGENT_ID=operiq-admin
ARMORIQ_MCP_NAME=operiq-mcp
OPERIQ_ADMIN_EMAILS=founder@example.com

# Use a long random value. Register this same value as the MCP Bearer token.
MCP_SHARED_SECRET=replace_with_a_long_random_secret

# Gmail delivery for owner-approved invitations whose execution is governed by ArmorIQ.
# Use a Google App Password, not the normal Gmail password.
GMAIL_USER=your_sender_account@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password
CLIENT_URL=http://localhost:5173
# Comma-separated deployed client and admin origins. Do not include paths.
CORS_ORIGINS=https://app.example.com,https://admin.example.com

